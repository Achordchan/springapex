node_modules/

# WordPress 本地站点：核心与运行数据不入库，只跟踪 wp-content/themes/springapex
/index.php
/wp-*.php
!/wp-router.php
/wp-admin/
/wp-includes/
/license.txt
/readme.html
/xmlrpc.php
/wp-content/index.php
/wp-content/debug.log
# 插件默认不入库；仅放行随仓库一起部署的官方免费插件（GPL）。
# 注意：代码入库 ≠ 自动启用，各站仍需在后台启用并跑一次插件设置页。
/wp-content/plugins/*
!/wp-content/plugins/webp-converter-for-media/
!/wp-content/plugins/wp-mail-smtp/
# WP Mail SMTP 运行时生成的邮件退信日志，不入库
/wp-content/plugins/wp-mail-smtp/.htaccess
/wp-content/plugins/wp-mail-smtp/*.log
/wp-content/uploads/
# Converter for Media 运行时转换产物（转好的 webp/avif），随上传内容生成，不入库
/wp-content/uploads-webpc/
# 插件按各环境自动生成的送达脚本与重写规则，不入库（每站由插件设置页重建）
/wp-content/webpc-passthru.php
/wp-content/.htaccess
/wp-content/languages/
/wp-content/upgrade/
/wp-content/themes/index.php

# Local tooling and review artifacts
.claude/
.codex_work/
.playwright-cli/
.zcode/
design-qa-assets/
evidence/
qa-artifacts/
output/
audit/
tmp/
.codex-*.png

# Patch leftovers and machine files
*.rej
*.orig
.DS_Store

# Local environment files
.env
.env.*
!.env.example
/deploy/.env
/deploy/data/
/deploy/wordpress/
/deploy/backups/

# 客户原始素材包（本地文件，超 GitHub 100MB 限制，不入库）
/客户提供.zip
