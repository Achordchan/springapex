#!/bin/sh
set -eu

valid_version() {
    value=$1
    line_count=$(printf '%s' "$value" | /usr/bin/wc -l | /usr/bin/tr -d '[:space:]')
    carriage_return=$(/usr/bin/printf '\r')
    if [ "$line_count" != '0' ]; then
        return 1
    fi
    case "$value" in
        ''|*/*|*\\*|*"$carriage_return"*)
            return 1
            ;;
    esac
    printf '%s\n' "$value" | /usr/bin/grep -Eq '^[0-9]+(\.[0-9]+)+$'
}

case "${SSH_ORIGINAL_COMMAND:-}" in
    springapex-health)
        exec /usr/bin/curl -fsS \
            --resolve www.norenspring.com:443:127.0.0.1 \
            https://www.norenspring.com/ >/dev/null
        ;;
    springapex-cdn-prepare\ *)
        version=${SSH_ORIGINAL_COMMAND#springapex-cdn-prepare }
        if ! valid_version "$version"; then
            echo 'The NorenSpring theme version is invalid.' >&2
            exit 1
        fi
        stage_root="/www/wwwroot/norenspring.com/wp-content/.springapex-cdn-stage"
        if [ -L "$stage_root" ] || [ "$(/usr/bin/realpath -e "$stage_root")" != "$stage_root" ]; then
            echo 'The NorenSpring CDN staging root is invalid.' >&2
            exit 1
        fi
        /bin/chmod 0700 -- "$stage_root"
        version_dir="$stage_root/$version"
        stage="$version_dir/assets"
        if [ -L "$version_dir" ] || [ -L "$stage" ]; then
            echo 'Symbolic links are not allowed in staged CDN paths.' >&2
            exit 1
        fi
        /bin/mkdir -p -- "$stage"
        if [ "$(/usr/bin/realpath -e "$stage")" != "$stage" ]; then
            echo 'The NorenSpring CDN staging path escaped its root.' >&2
            exit 1
        fi
        /bin/chmod 0700 -- \
            "/www/wwwroot/norenspring.com/wp-content/.springapex-cdn-stage/$version" \
            "$stage"
        ;;
    springapex-cdn-sync\ *)
        version=${SSH_ORIGINAL_COMMAND#springapex-cdn-sync }
        if ! valid_version "$version"; then
            echo 'The NorenSpring theme version is invalid.' >&2
            exit 1
        fi
        stage_root="/www/wwwroot/norenspring.com/wp-content/.springapex-cdn-stage"
        if [ -L "$stage_root" ] || [ "$(/usr/bin/realpath -e "$stage_root")" != "$stage_root" ]; then
            echo 'The NorenSpring CDN staging root is invalid.' >&2
            exit 1
        fi
        /bin/chmod 0700 -- "$stage_root"
        version_dir="$stage_root/$version"
        stage="$version_dir/assets"
        if [ -L "$version_dir" ] || [ -L "$stage" ]; then
            echo 'Symbolic links are not allowed in staged CDN paths.' >&2
            exit 1
        fi
        if [ ! -d "$stage" ]; then
            echo 'The staged NorenSpring CDN assets are missing.' >&2
            exit 1
        fi
        if /usr/bin/find "$stage" -type l -print -quit | /usr/bin/grep -q .; then
            echo 'Symbolic links are not allowed in staged CDN assets.' >&2
            exit 1
        fi
        /usr/local/bin/aws s3 sync \
            "$stage/" \
            "s3://norenspring-prod-storage-20260825-7e4c9a/public/theme/$version/assets/" \
            --delete \
            --no-follow-symlinks \
            --only-show-errors
        /bin/rm -rf -- "$version_dir"
        ;;
    *)
        echo 'This command can only stage/sync NorenSpring CDN assets or run its health check.' >&2
        exit 126
        ;;
esac
