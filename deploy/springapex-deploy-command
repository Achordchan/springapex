#!/bin/sh
set -eu

case "${SSH_ORIGINAL_COMMAND:-}" in
    rsync\ --server*)
        # Ubuntu's packaged rrsync allowlist accepts the short -d form but omits
        # the equivalent --dirs emitted by some rsync clients (notably macOS).
        SSH_ORIGINAL_COMMAND=$(printf '%s\n' "$SSH_ORIGINAL_COMMAND" | sed 's/ --dirs / -d /g')
        export SSH_ORIGINAL_COMMAND
        exec /usr/bin/rrsync -wo /srv/springapex/wordpress/wp-content
        ;;
    springapex-health)
        if /usr/bin/curl -fsS --resolve web.apex-springs.com:443:127.0.0.1 https://web.apex-springs.com/ >/dev/null 2>&1; then
            exit 0
        fi
        exec /usr/bin/curl -fsS -H 'Host: web.apex-springs.com' http://127.0.0.1/ >/dev/null
        ;;
    *)
        echo 'This key can only deploy SpringApex code or run its health check.' >&2
        exit 126
        ;;
esac
