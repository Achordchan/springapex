#!/bin/sh
set -eu

case "${SSH_ORIGINAL_COMMAND:-}" in
    rsync\ --server*)
        # Ubuntu's packaged rrsync allowlist accepts the short -d form but omits
        # the equivalent --dirs emitted by some rsync clients (notably macOS).
        SSH_ORIGINAL_COMMAND=$(printf '%s\n' "$SSH_ORIGINAL_COMMAND" | sed 's/ --dirs / -d /g')
        export SSH_ORIGINAL_COMMAND
        exec /usr/bin/rrsync -wo /www/wwwroot/norenspring.com/wp-content
        ;;
    springapex-health)
        exec /usr/bin/curl -fsS \
            --resolve norenspring.com:443:127.0.0.1 \
            https://norenspring.com/ >/dev/null
        ;;
    springapex-cdn-prepare\ *)
        version=${SSH_ORIGINAL_COMMAND#springapex-cdn-prepare }
        case "$version" in
            ''|*[!0-9.]* )
                echo 'The NorenSpring theme version is invalid.' >&2
                exit 1
                ;;
        esac
        stage="/www/wwwroot/norenspring.com/wp-content/.springapex-cdn-stage/$version/assets"
        /bin/mkdir -p -- "$stage"
        /bin/chmod 2775 -- \
            "/www/wwwroot/norenspring.com/wp-content/.springapex-cdn-stage/$version" \
            "$stage"
        ;;
    springapex-cdn-sync\ *)
        version=${SSH_ORIGINAL_COMMAND#springapex-cdn-sync }
        case "$version" in
            ''|*[!0-9.]* )
                echo 'The NorenSpring theme version is invalid.' >&2
                exit 1
                ;;
        esac
        stage="/www/wwwroot/norenspring.com/wp-content/.springapex-cdn-stage/$version/assets"
        if [ ! -d "$stage" ]; then
            echo 'The staged NorenSpring CDN assets are missing.' >&2
            exit 1
        fi
        if /usr/bin/find "$stage" -type l -print -quit | /usr/bin/grep -q .; then
            echo 'Symbolic links are not allowed in staged CDN assets.' >&2
            exit 1
        fi
        /usr/bin/aws s3 sync \
            "$stage/" \
            "s3://norenspring-prod-storage-20260825-7e4c9a/public/theme/$version/assets/" \
            --delete \
            --no-follow-symlinks \
            --only-show-errors
        /bin/rm -rf -- "/www/wwwroot/norenspring.com/wp-content/.springapex-cdn-stage/$version"
        ;;
    *)
        echo 'This key can only deploy NorenSpring code, stage/sync CDN assets or run its health check.' >&2
        exit 126
        ;;
esac
